{
    "version": 6,
    "cmakeMinimumRequired": {
        "major": 3,
        "minor": 25,
        "patch": 0
    },
    "configurePresets": [
        {
            "name": "release",
            "hidden": true,
            "description":"Template for building release version"
        },
        {
            "name": "factory",
            "hidden": true,
            "description":"Template for building factory version",
            "cacheVariables":{
                "PRESET_DEFINITIONS":"BUILD_FACTORY_VERSION"
            }
        },
        {
            "name": "ads",
            "hidden": true,
            "description":"Template for building with ADS",
            "generator": "Ninja",
            "binaryDir":"${sourceDir}/build",
            "cacheVariables":{
                "TOOLCHAIN":"ADS"
            }
        },
        {
            "name": "tasking",
            "hidden": true,
            "description":"Template for building with tasking",
            "generator": "Ninja",
            "binaryDir":"${sourceDir}/build",
            "cacheVariables":{
                "TOOLCHAIN":"Tasking"
            }
        },
        {
            "name": "tc39x",
            "hidden": true,
            "description":"Template for building customer tc39x version",
            "cacheVariables":{
                "TARGET":"tc39x"
            }
        },
        {
            "name": "tc397_eth",
            "displayName":"tc397 eth project",
            "binaryDir":"${sourceDir}/build/tc397_eth",
            "inherits":[
                "release",
                "tasking",
                "tc39x"
            ]
        }
    ],
    "buildPresets": [
        {
            "name":"tc397_eth",
            "configurePreset": "tc397_eth"
        }
    ]
}